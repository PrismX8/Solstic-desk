{
  "appId": "com.solstice.desk",
  "productName": "Solstice Desk",
  "directories": {
    "output": "release"
  },
  "files": [
    "main.js",
    "preload.js",
    "relay.js",
    "package.json",
    "assets/**/*",
    "host/**/*",
    "native/**/*",
    "build/Release/**/*",
    "resources/ui/**/*"
  ],
  "asarUnpack": [
    "node_modules/screenshot-desktop/**/*",
    "build/Release/**/*"
  ],
  "win": {
    "icon": "assets/icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "installerIcon": "assets/icon.ico",
    "uninstallerIcon": "assets/icon.ico",
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  },
  "publish": [
    {
      "provider": "github",
      "owner": "PrismX8",
      "repo": "Solstic-desk",
      "releaseType": "release"
    }
  ]
}

